# 复制为 .env 后按需修改（当前实现直接从 process.env 读取，可用任意方式注入）

PORT=3000
# DB_PATH=./data/freshpage.db

# 抓取边界
FP_MAX_PAGES=50
FP_MAX_DEPTH=2
FP_SCAN_CONCURRENCY=3
FP_REQUEST_TIMEOUT_MS=12000
FP_MAX_RESPONSE_BYTES=2000000
FP_MAX_REDIRECTS=5
FP_SCAN_BUDGET_MS=480000
FP_CRAWL_DELAY_MS=150
FP_RETRY_5XX=1
# FP_USER_AGENT=FreshPageBot/0.1 (+https://freshpage.example/bot)

# 安全（生产环境不要打开 FP_ALLOW_PRIVATE_TARGETS）
FP_ALLOW_PRIVATE_TARGETS=0
FP_ALLOWED_PORTS=80,443

# AI 复核（不配置则自动降级为纯规则报告）
FP_AI_ENABLED=1
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
FP_AI_MIN_CONFIDENCE=0.55
FP_AI_TIMEOUT_MS=30000
FP_AI_MAX_CANDIDATES=12
FP_AI_MAX_CALLS=2

# 浏览器回退（需要 npm i playwright && npx playwright install chromium）
# 本机已安装 Chromium，可置 1；未安装时代码会静默降级，不影响主流程
FP_BROWSER_FALLBACK=1
FP_BROWSER_TIMEOUT_MS=20000

# 前端埋点（匿名，仅事件名 + 结果 token + 会话哈希）
FP_TELEMETRY_ENABLED=1
FP_TELEMETRY_MAX_PER_SESSION_DAY=200

# 数据保留与防滥用
FP_RETENTION_DAYS=7
FP_CLEANUP_INTERVAL_MS=3600000
FP_MAX_SCANS_PER_IP=6
FP_MAX_SCANS_PER_IP_DAY=30
FP_DOMAIN_COOLDOWN_MS=300000
FP_GLOBAL_CONCURRENT_SCANS=3
FP_MAX_QUEUED_SCANS=50
FP_DAILY_PAGE_BUDGET=5000
FP_IP_SALT=change-me-in-production

# 分离部署：Web 进程设 FP_API_ONLY=1，Worker 进程设 FP_WORKER_ONLY=1
# FP_API_ONLY=0
# FP_WORKER_ONLY=0
