{
  "name": "freshpage",
  "version": "0.1.0",
  "private": true,
  "description": "FreshPage V0 - 无需登录的网站内容体检工具",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "worker": "node dist/src/worker.js",
    "dev": "npm run build && node dist/src/index.js",
    "test": "npm run build && node --test dist/tests/unit/*.test.js dist/tests/integration/*.test.js",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/*.test.js",
    "cleanup": "node dist/src/cleanup-cli.js",
    "stats": "npm run build && node dist/src/scripts/validation-stats.js",
    "gen:sample": "npm run build && FP_ALLOW_PRIVATE_TARGETS=1 node dist/src/scripts/gen-sample-report.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}
